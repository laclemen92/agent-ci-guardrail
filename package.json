{
  "name": "agent-ci-guardrail",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action: light CI for AI coding agents work in progress, full suite when the PR is ready.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/guardrail/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --legal-comments=none",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
